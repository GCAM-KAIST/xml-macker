<UserControl x:Class="XMLMacker.Windows.ErrorsPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:XMLMacker.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xml-macker;component/Shared/FixCell.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource XM.bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderNote" Margin="10,8,10,6"
                   TextTrimming="CharacterEllipsis"
                   FontFamily="Segoe UI" FontSize="10"
                   Foreground="{DynamicResource XM.ok}" />
        <Border Grid.Row="1" Margin="8,0,8,8" Background="{DynamicResource XM.bgDeep}">
            <shared:KeyActivatableListView x:Name="ErrorsList"
                    Background="Transparent" BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                <shared:KeyActivatableListView.View>
                    <GridView>
                        <GridViewColumn Header="Fix" Width="60" CellTemplate="{StaticResource XM.FixCellTemplate}" />
                        <GridViewColumn Header="Line" Width="60">
                            <GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding Line}" FontFamily="Cascadia Mono, Consolas"
                                           FontWeight="Bold" Foreground="{DynamicResource XM.accent}" />
                            </DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Col" Width="50" DisplayMemberBinding="{Binding Column}" />
                        <GridViewColumn Header="Message" Width="340">
                            <GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                           FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource XM.text}" />
                            </DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </shared:KeyActivatableListView.View>
            </shared:KeyActivatableListView>
        </Border>
    </Grid>
</UserControl>
