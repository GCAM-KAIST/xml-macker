<Window x:Class="XMLMacker.Windows.OrbitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XMLMacker.Windows"
        Width="1080" Height="720" MinWidth="760" MinHeight="540"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource XM.bgDeep}"
        Title="Orbit, xml-macker">
    <!--  Implicit styles for every control in this window. Without them WPF paints its stock Aero
          chrome: a WHITE attribute grid with black text and a WHITE text box sitting on the app's
          near-black panel, the single largest reason this window did not look designed for Windows.
          Colours come from the active theme dictionary, so all six themes stay correct.  -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{DynamicResource XM.panel}"
                                BorderBrush="{DynamicResource XM.hairlineS}"
                                BorderThickness="0.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{DynamicResource XM.text3}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource XM.bgDeep}" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource XM.text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource XM.hairlineS}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="SelectionBrush" Value="{DynamicResource XM.accent}" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource XM.bgDeep}" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource XM.hairlineS}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource XM.hairlineS}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="RowHeight" Value="22" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!--  Width is recomputed from the window size in UpdateChrome (min 230, max 350, 31%).  -->
            <ColumnDefinition Width="336" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <local:OrbitView x:Name="View" />
            <!--  Bottom-RIGHT, not bottom-centre: centred these two buttons floated on top of the drawn
                  ring. They also hide themselves when every child already fits (see UpdateChrome).  -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,7">
                <Button x:Name="PreviousPageButton" Content="Previous" Padding="14,4" Margin="2" Click="PreviousPage_Click" />
                <Button x:Name="NextPageButton" Content="Next" Padding="14,4" Margin="2" Click="NextPage_Click" />
            </StackPanel>
            <CheckBox x:Name="StructureOnlyCheck" Content="Structure only"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,9"
                      Checked="StructureOnly_Changed" Unchecked="StructureOnly_Changed" />
        </Grid>

        <Border Grid.Column="1" BorderBrush="{DynamicResource XM.hairlineS}" BorderThickness="1,0,0,0"
                Background="{DynamicResource XM.panel}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="112" />
                </Grid.RowDefinitions>
                <TextBlock Text="SELECTED ELEMENT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource XM.text3}" />
                <TextBlock x:Name="NodeTitle" Grid.Row="1" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas"
                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource XM.syntaxTag}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NodeMetadata" Grid.Row="2" Margin="0,5,0,0" FontSize="10"
                           Foreground="{DynamicResource XM.text3}" TextTrimming="CharacterEllipsis" />
                <UniformGrid Grid.Row="3" Columns="4" Margin="0,10,0,0">
                    <Button x:Name="ParentButton" Content="↑ Parent" Margin="0,0,2,0" Click="Parent_Click" />
                    <Button x:Name="PreviousButton" Content="◀ Prev" Margin="2,0" Click="Previous_Click" />
                    <Button x:Name="NextButton" Content="Next ▶" Margin="2,0" Click="Next_Click" />
                    <Button x:Name="ChildButton" Content="↓ Child" Margin="2,0,0,0" Click="Child_Click" />
                </UniformGrid>
                <Grid Grid.Row="4" Margin="0,14,0,6">
                    <TextBlock Text="ATTRIBUTES" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource XM.text3}" />
                    <TextBlock Text="double-click a value to edit" HorizontalAlignment="Right" FontSize="9"
                               Foreground="{DynamicResource XM.text3}" />
                </Grid>
                <DataGrid x:Name="AttributesGrid" Grid.Row="5" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                          CellEditEnding="AttributesGrid_CellEditEnding"
                          PreviewMouseRightButtonDown="AttributesGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="AttributeContextMenu_Opened">
                            <MenuItem Header="Copy Attribute Name" Click="CopyAttributeName_Click" />
                            <MenuItem Header="Copy Attribute Value" Click="CopyAttributeValue_Click" />
                            <MenuItem Header="Copy name=&quot;value&quot;" Click="CopyAttributeAssignment_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="105" IsReadOnly="True" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="6" Margin="0,14,0,6">
                    <TextBlock x:Name="TextLabel" Text="TEXT CONTENT" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource XM.text3}" />
                    <Button x:Name="ApplyTextButton" Content="Apply" HorizontalAlignment="Right" Padding="10,2"
                            Click="ApplyText_Click" />
                </Grid>
                <TextBox x:Name="TextEditor" Grid.Row="7" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                         TextChanged="TextEditor_TextChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
