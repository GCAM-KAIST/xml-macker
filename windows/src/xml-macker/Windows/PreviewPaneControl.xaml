<UserControl x:Class="XMLMacker.Windows.PreviewPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:XMLMacker.Shared"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xml-macker;component/Shared/FixCell.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Segmented toggle segment -->
            <Style x:Key="SegToggle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent"
                                    BorderBrush="{DynamicResource XM.hairlineS}" BorderThickness="0.5"
                                    Padding="6,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.panel}" />
                                    <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource XM.bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs + header -->
        <Grid Grid.Row="0" Margin="10,6,10,0">
            <StackPanel x:Name="PreviewTabStrip" Orientation="Horizontal" HorizontalAlignment="Left">
                <RadioButton x:Name="PreviewTab" Style="{StaticResource SegToggle}" GroupName="pv"
                             Width="74" Content="Preview" IsChecked="True" />
                <RadioButton x:Name="ErrorsTab" Style="{StaticResource SegToggle}" GroupName="pv"
                             Width="92" Content="Errors" />
            </StackPanel>
            <TextBlock x:Name="HeaderNote" Margin="184,0,10,0" VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="10" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource XM.text3}" />
        </Grid>

        <!-- Content: preview + errors overlaid -->
        <Grid Grid.Row="1" Margin="8,6,8,8">
            <Border x:Name="PreviewScroll" Background="{DynamicResource XM.bgDeep}">
                <TextBox x:Name="PreviewView"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="6"
                         Background="Transparent"
                         Foreground="{DynamicResource XM.text}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11" />
            </Border>

            <Border x:Name="ErrorsScroll" Background="{DynamicResource XM.bgDeep}" Visibility="Collapsed">
                <shared:KeyActivatableListView x:Name="ErrorsList"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <shared:KeyActivatableListView.View>
                        <GridView>
                            <GridViewColumn Header="Line" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource XM.accent}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Col" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Column}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                   Foreground="{DynamicResource XM.text3}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Message" Width="340">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                   Foreground="{DynamicResource XM.text}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fix" Width="60"
                                            CellTemplate="{StaticResource XM.FixCellTemplate}" />
                        </GridView>
                    </shared:KeyActivatableListView.View>
                </shared:KeyActivatableListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
