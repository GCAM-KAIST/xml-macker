<Window x:Class="XMLMacker.Windows.FindPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:XMLMacker.Shared"
        Width="560" Height="190"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource XM.bg}"
        Title="Find &amp; Replace">
    <Window.Resources>
        <Style x:Key="FindButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{DynamicResource XM.panel}"
                                BorderBrush="{DynamicResource XM.hairlineS}"
                                BorderThickness="0.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource XM.bg}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource FindButton}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text3}" />
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Find row -->
        <Grid Grid.Row="0" Margin="14,14,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Find" />
            <TextBox x:Name="FindField" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Background="{DynamicResource XM.bgDeep}" Foreground="{DynamicResource XM.text}"
                     BorderBrush="{DynamicResource XM.hairlineS}" BorderThickness="0.5"
                     Tag="Text to find" />
        </Grid>

        <!-- Replace row -->
        <Grid Grid.Row="1" Margin="14,16,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Replace" />
            <TextBox x:Name="ReplField" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Background="{DynamicResource XM.bgDeep}" Foreground="{DynamicResource XM.text}"
                     BorderBrush="{DynamicResource XM.hairlineS}" BorderThickness="0.5"
                     Tag="Replacement" />
        </Grid>

        <!-- Options + scope -->
        <Grid Grid.Row="2" Margin="14,12,14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <CheckBox x:Name="CaseBox" Content="Match case" Foreground="{DynamicResource XM.text2}"
                          FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" />
                <CheckBox x:Name="WordBox" Content="Whole word" Margin="12,0,0,0"
                          Foreground="{DynamicResource XM.text2}"
                          FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"
                          ToolTip="Whole word means e.g. &quot;price&quot; won't match inside &quot;price-elasticity&quot;." />
            </StackPanel>
            <TextBlock x:Name="ScopeLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxWidth="260"
                       Foreground="{DynamicResource XM.accent}" />
        </Grid>

        <!-- Button rows -->
        <Grid Grid.Row="3" Margin="14,12,14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="PrevBtn" Style="{StaticResource FindButton}" Content="◀ Previous" />
                <Button x:Name="NextBtn" Style="{StaticResource FindButton}" Margin="8,0,0,0" Content="Next ▶" IsDefault="True" />
                <Button x:Name="FindAllBtn" Style="{StaticResource FindButton}" Margin="8,0,0,0" Content="Find All" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ReplaceBtn" Style="{StaticResource FindButton}" Content="Replace" />
                <Button x:Name="ReplaceAllBtn" Style="{StaticResource FindButton}" Margin="8,0,0,0" Content="Replace All" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusLabel" Grid.Row="4" Margin="14,10,14,0"
                   FontFamily="Segoe UI" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource XM.text2}" />

        <!-- Results header -->
        <Grid Grid.Row="5" x:Name="ResultsHeaderRow" Margin="14,10,14,0" Visibility="Collapsed">
            <TextBlock x:Name="ResultsHeader" VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource XM.text2}" />
            <Button x:Name="ExportBtn" Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Content="Export CSV…" />
        </Grid>

        <!-- Results table -->
        <Border Grid.Row="6" x:Name="ResultsScroll" Margin="14,6,14,12"
                Background="{DynamicResource XM.bgDeep}"
                BorderBrush="{DynamicResource XM.hairlineS}" BorderThickness="0.5"
                Visibility="Collapsed">
            <shared:KeyActivatableListView x:Name="ResultsTable"
                    Background="Transparent" BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                <shared:KeyActivatableListView.View>
                    <GridView>
                        <GridViewColumn Header="Line" Width="66">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Line}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource XM.accent}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Path" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="{DynamicResource XM.syntaxAttr}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Text" Width="230">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="{DynamicResource XM.text}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </shared:KeyActivatableListView.View>
            </shared:KeyActivatableListView>
        </Border>
    </Grid>
</Window>
