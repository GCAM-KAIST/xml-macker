<Window x:Class="XMLMacker.Windows.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="1200" Height="760" MinWidth="800" MinHeight="480"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource XM.bg}"
        Title="Diff">
    <Window.Resources>
        <!-- Small rounded push button (bezelStyle .rounded, controlSize .small). -->
        <Style x:Key="DiffButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{DynamicResource XM.panel}"
                                BorderBrush="{DynamicResource XM.hairlineS}"
                                BorderThickness="0.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiscButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource XM.text3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="14" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="12,10,12,0" Height="26">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Style="{StaticResource DiffButton}" Content="◀ Previous" />
                <Button x:Name="NextBtn" Style="{StaticResource DiffButton}" Margin="6,0,0,0" Content="Next ▶" />
                <Button x:Name="TreeBtn" Style="{StaticResource DiffButton}" Margin="12,0,0,0" Content="Tree"
                        ToolTip="Show the element tree, click an element to jump to it and limit Next/Previous to differences inside it. Click the file name at the top of the tree to switch to the other file's tree." />
                <Button x:Name="ScopeBtn" Style="{StaticResource DiffButton}" Margin="8,0,0,0" Content="✕ Whole File"
                        Visibility="Collapsed"
                        ToolTip="Stop limiting to the selected element, walk every difference again" />
                <CheckBox x:Name="LineModeCheck" Content="Line by line" Margin="14,0,0,0" VerticalAlignment="Center"
                          FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource XM.text}" Cursor="Hand"
                          ToolTip="On: Next and Previous move one changed line at a time and Copy moves that line. Off: they work on whole blocks." />
                <TextBlock x:Name="StatusField" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource XM.text2}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UndoCopyBtn" Style="{StaticResource DiffButton}" Margin="0,0,12,0" Content="↶ Undo Copy"
                        IsEnabled="False" ToolTip="Put back exactly what the last copy replaced" />
                <Button x:Name="CopyLeftBtn" Style="{StaticResource DiffButton}" Content="Copy From Left ▶" />
                <Button x:Name="CopyRightBtn" Style="{StaticResource DiffButton}" Margin="6,0,0,0" Content="◀ Copy From Right" />
            </StackPanel>
        </Grid>

        <!-- 3-pane split -->
        <Grid x:Name="MainGrid" Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeCol" Width="0" MinWidth="0" />
                <ColumnDefinition x:Name="TreeSplitCol" Width="0" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <!-- Tree sidebar -->
            <Border Grid.Column="0" x:Name="TreePane"
                    Background="{DynamicResource XM.bgDeep}" Visibility="Collapsed">
                <ListBox x:Name="TreeList"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="rowbd" Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="0" Height="20">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="rowbd" Property="Background" Value="{DynamicResource XM.lineHighlight}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                <Button Style="{StaticResource DiscButton}" Content="{Binding Glyph}" Tag="disc" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource XM.syntaxTag}" />
                                <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" Margin="6,0,0,0"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource XM.text3}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="TreeSplitter" Width="0" HorizontalAlignment="Stretch"
                          Background="{DynamicResource XM.hairline}" Visibility="Collapsed" />

            <!-- Left source pane -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="6,2,6,0" LastChildFill="True">
                    <!--  Swap this side for another open tab, or open a new file into the comparison.  -->
                    <Button x:Name="LeftChangeBtn" DockPanel.Dock="Right" Style="{StaticResource DiffButton}"
                            Content="Change ▾" Padding="8,1" Margin="8,0,0,0"
                            ToolTip="Compare a different file on this side" />
                    <TextBlock x:Name="LeftNameLabel" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource XM.syntaxTag}" />
                </DockPanel>
                <Border Grid.Row="1" x:Name="LeftHost" Margin="0,4,0,0"
                        Background="{DynamicResource XM.bgDeep}" />
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center"
                          Background="{DynamicResource XM.hairline}" />

            <!-- Right source pane -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="6,2,6,0" LastChildFill="True">
                    <!--  Swap this side for another open tab, or open a new file into the comparison.  -->
                    <Button x:Name="RightChangeBtn" DockPanel.Dock="Right" Style="{StaticResource DiffButton}"
                            Content="Change ▾" Padding="8,1" Margin="8,0,0,0"
                            ToolTip="Compare a different file on this side" />
                    <TextBlock x:Name="RightNameLabel" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource XM.syntaxTag}" />
                </DockPanel>
                <Border Grid.Row="1" x:Name="RightHost" Margin="0,4,0,0"
                        Background="{DynamicResource XM.bgDeep}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
