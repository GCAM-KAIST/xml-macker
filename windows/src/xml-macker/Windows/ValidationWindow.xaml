<Window x:Class="XMLMacker.Windows.ValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:XMLMacker.Shared"
        Width="640" Height="380"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource XM.bg}"
        Title="Validation">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xml-macker;component/Shared/FixCell.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ValButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="6"
                                    Background="{DynamicResource XM.panel}"
                                    BorderBrush="{DynamicResource XM.hairlineS}"
                                    BorderThickness="0.5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status + Re-validate -->
        <Grid Grid.Row="0">
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource XM.text}" />
            <Button x:Name="RevalidateBtn" Style="{StaticResource ValButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Content="Re-validate" />
        </Grid>

        <!-- Hint -->
        <TextBlock x:Name="HintLabel" Grid.Row="1" Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{DynamicResource XM.text3}" />

        <!-- Errors table -->
        <Border Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource XM.bgDeep}">
            <shared:KeyActivatableListView x:Name="ErrorsList"
                    Background="Transparent" BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                <shared:KeyActivatableListView.View>
                    <GridView>
                        <GridViewColumn Header="Fix" Width="60"
                                        CellTemplate="{StaticResource XM.FixCellTemplate}" />
                        <GridViewColumn Header="Line" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Line}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="Bold"
                                               Foreground="{DynamicResource XM.accent}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Col" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Column}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource XM.text3}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Message" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource XM.text}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </shared:KeyActivatableListView.View>
            </shared:KeyActivatableListView>
        </Border>
    </Grid>
</Window>
