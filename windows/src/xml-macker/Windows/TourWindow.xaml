<Window x:Class="XMLMacker.Windows.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False">
    <Canvas x:Name="Overlay" Focusable="True" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Path x:Name="DimPath" Fill="#99000000" />
        <Canvas x:Name="Rings" IsHitTestVisible="False" />
        <Border x:Name="Card" Width="400" Padding="16,12,14,12" CornerRadius="12"
                Background="{DynamicResource XM.panel}" BorderBrush="{DynamicResource XM.accent}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TourTitle" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource XM.text}" />
                <!-- The body scrolls when a page would not fit between the anchor and the taskbar. -->
                <ScrollViewer Grid.Row="1" Margin="0,6,0,10" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TourBody" TextWrapping="Wrap"
                               FontSize="12" LineHeight="18" Foreground="{DynamicResource XM.text2}" />
                </ScrollViewer>
                <Grid Grid.Row="2">
                    <TextBlock x:Name="Counter" VerticalAlignment="Center" FontSize="10"
                               Foreground="{DynamicResource XM.text3}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Padding="12,3" Margin="0,0,14,0" Click="Close_Click" />
                        <Button x:Name="BackButton" Content="Back" Padding="12,3" Margin="0,0,6,0" Click="Back_Click" />
                        <Button x:Name="NextButton" Content="Next" Padding="12,3" IsDefault="True" Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
