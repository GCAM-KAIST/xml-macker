<Window x:Class="XMLMacker.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About xml-macker" Width="360" Height="400"
        ResizeMode="NoResize" SizeToContent="Manual" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource XM.bg}">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="26" />
            <RowDefinition Height="34" />
            <RowDefinition Height="24" />
            <RowDefinition Height="24" />
            <RowDefinition Height="30" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Viewbox Width="112" Height="112" HorizontalAlignment="Center">
            <Canvas Width="128" Height="128">
                <Rectangle Width="128" Height="128" RadiusX="28" RadiusY="28">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4780D2" Offset="0" />
                            <GradientStop Color="#004296" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Path Data="M40,40 L23,64 L40,88" Fill="Transparent" Stroke="#F1F5FC"
                      StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path Data="M88,40 L105,64 L88,88" Fill="Transparent" Stroke="#F1F5FC"
                      StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Ellipse Canvas.Left="38" Canvas.Top="50" Width="52" Height="28" Fill="Transparent"
                         Stroke="#8FF1F5FC" StrokeThickness="3" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-22" /></Ellipse.RenderTransform>
                </Ellipse>
                <Line X1="60" Y1="56" X2="60" Y2="72" Stroke="#BFF1F5FC" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="60" Y1="61" X2="68" Y2="61" Stroke="#BFF1F5FC" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="60" Y1="67" X2="68" Y2="67" Stroke="#BFF1F5FC" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="57" Canvas.Top="53" Width="6" Height="6" Fill="#FF9B50" />
                <Ellipse Canvas.Left="65.5" Canvas.Top="58.5" Width="5" Height="5" Fill="#32C8A9" />
                <Ellipse Canvas.Left="65.5" Canvas.Top="64.5" Width="5" Height="5" Fill="#C480D4" />
            </Canvas>
        </Viewbox>

        <TextBlock x:Name="ProductText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="20" FontWeight="Bold" Foreground="{DynamicResource XM.text}" />
        <TextBlock Grid.Row="3" Text="Developed by Ahmed SM Sobhy" HorizontalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource XM.text2}" />
        <TextBlock Grid.Row="4" Text="KAIST IAM GROUP" HorizontalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource XM.text2}" />
        <TextBlock Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
            <Hyperlink NavigateUri="https://github.com/GCAM-KAIST" RequestNavigate="Link_RequestNavigate">
                github.com/GCAM-KAIST
            </Hyperlink>
        </TextBlock>
        <TextBlock Grid.Row="6" Text="MIT license" HorizontalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource XM.text3}" />
        <Button Grid.Row="8" Width="160" Height="30" Content="OK" IsDefault="True"
                HorizontalAlignment="Center" Click="Ok_Click" />
    </Grid>
</Window>
