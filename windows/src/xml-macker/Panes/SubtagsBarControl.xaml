<UserControl x:Class="XMLMacker.Panes.SubtagsBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XMLMacker.Panes"
             x:Name="Self"
             Background="Transparent">
    <UserControl.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />

        <!-- The per-row "↗" Go button (NAVIGATE). Hidden on the self-leaf row. -->
        <DataTemplate x:Key="GoCellTemplate">
            <Button Content="↗"
                    Tag="go"
                    Cursor="Hand"
                    Focusable="False"
                    FontFamily="Segoe UI" FontWeight="SemiBold"
                    ToolTip="Navigate to this element"
                    Foreground="{DynamicResource XM.accent}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Width="26" Height="20"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsSelfLeaf, Converter={StaticResource InvBoolVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Title" Grid.Row="0"
                   Text="SUBTAGS"
                   Margin="10,4,10,0"
                   FontFamily="Segoe UI" FontWeight="Medium"
                   Foreground="{DynamicResource XM.text3}" />

        <!-- Rounded hairline frame around the table area (bgDeep@0.35 fill set in code). -->
        <Border x:Name="Frame" Grid.Row="1"
                Margin="10,4,10,8"
                CornerRadius="8"
                BorderThickness="0.5"
                BorderBrush="{DynamicResource XM.hairlineS}">
            <DataGrid x:Name="Grid"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="Transparent" RowBackground="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource XM.hairline}"
                      VerticalGridLinesBrush="{DynamicResource XM.hairline}"
                      FontFamily="Cascadia Mono, Consolas"
                      Foreground="{DynamicResource XM.text}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>
