<UserControl x:Class="XMLMacker.Panes.HierarchyBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XMLMacker.Panes"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The pane's own header bar already says HIERARCHY; a second title inside was pure repetition.  -->
        <TextBlock x:Name="Title" Grid.Row="0" Visibility="Collapsed"
                   Text="HIERARCHY"
                   Margin="10,4,0,0"
                   Foreground="{DynamicResource XM.text3}" />

        <CheckBox x:Name="StructureOnlyCheck"
                  Grid.Row="0"
                  Content="Structure only"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="12,2,10,0"
                  Foreground="{DynamicResource XM.text2}"
                  ToolTip="Show elements that contain other elements; plain values fold into one summary bar"
                  Click="StructureOnlyCheck_Click" />

        <local:HierarchyMiniView x:Name="Mini" Grid.Row="1"
                                 Margin="10,4,10,8" />
    </Grid>
</UserControl>
