<UserControl x:Class="XMLMacker.Panes.TreePaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XMLMacker.Panes"
             x:Name="Self"
             Background="Transparent">
    <UserControl.Resources>
        <local:DepthToMarginConverter x:Key="DepthMargin" />

        <!-- Custom selection fill/stroke. Not theme-dictionary keys (they are accent@alpha washes),
             so the code-behind mutates their .Color on load + ThemeChanged. Referenced via
             DynamicResource in the ListBoxItem template trigger. -->
        <SolidColorBrush x:Key="Tree.SelFill" Color="Transparent" />
        <SolidColorBrush x:Key="Tree.SelStroke" Color="Transparent" />
    </UserControl.Resources>

    <!-- Scroll host inset 4pt on all sides (Swift NSScrollView inset). -->
    <Border Padding="4" Background="Transparent">
        <ListBox x:Name="List"
                 Background="Transparent"
                 BorderThickness="0"
                 Focusable="True"
                 SelectionMode="Single"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 VirtualizingStackPanel.ScrollUnit="Item"
                 ItemsSource="{Binding VisibleRows, ElementName=Self}">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Height"
                            Value="{Binding RowPixelHeight, ElementName=Self}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- Fully custom template: no SystemColors highlight exists, so
                                     selection never grays on focus loss. -->
                                <Border x:Name="SelBorder"
                                        CornerRadius="6"
                                        Margin="3,1"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0.5"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SelBorder" Property="Background"
                                                Value="{DynamicResource Tree.SelFill}" />
                                        <Setter TargetName="SelBorder" Property="BorderBrush"
                                                Value="{DynamicResource Tree.SelStroke}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True"
                               Margin="{Binding Depth, Converter={StaticResource DepthMargin}}">
                        <local:KindGlyph DockPanel.Dock="Left"
                                         Kind="{Binding Kind}"
                                         Width="10" Height="10"
                                         Margin="2,0,0,0"
                                         VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Label}"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="{Binding NameFontSize, ElementName=Self}"
                                   Foreground="{DynamicResource XM.text}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   FontFamily="Segoe UI"
                                   FontWeight="Normal"
                                   FontSize="{Binding DetailFontSize, ElementName=Self}"
                                   Foreground="{DynamicResource XM.text3}"
                                   Margin="8,0,6,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>
