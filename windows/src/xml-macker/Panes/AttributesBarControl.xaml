<UserControl x:Class="XMLMacker.Panes.AttributesBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XMLMacker.Panes"
             x:Name="Self"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ATTRIBUTES (N) -->
        <TextBlock x:Name="AttrTitle" Grid.Row="0"
                   Text="ATTRIBUTES"
                   Margin="10,4,10,0"
                   FontFamily="Segoe UI" FontWeight="Medium"
                   Foreground="{DynamicResource XM.text3}" />

        <!-- Attributes table: Name (read-only, syntaxAttr) | Value (editable, syntaxVal) -->
        <DataGrid x:Name="Grid" Grid.Row="1"
                  Margin="10,4,10,0"
                  MinHeight="40"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single" SelectionUnit="Cell"
                  Background="Transparent" RowBackground="Transparent"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource XM.hairline}"
                  VerticalGridLinesBrush="{DynamicResource XM.hairline}"
                  FontFamily="Cascadia Mono, Consolas"
                  Foreground="{DynamicResource XM.text}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName" Header="Name" Width="120" MinWidth="70"
                                    IsReadOnly="True"
                                    Binding="{Binding Name}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource XM.syntaxAttr}" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="ColValue" Header="Value" Width="220" MinWidth="80"
                                    Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource XM.syntaxVal}" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="{DynamicResource XM.syntaxVal}" />
                            <Setter Property="Padding" Value="2,0" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- TEXT CONTENT header -->
        <TextBlock x:Name="TextHeader" Grid.Row="2"
                   Text="TEXT CONTENT"
                   Margin="10,8,10,0"
                   FontFamily="Segoe UI" FontWeight="Medium"
                   Foreground="{DynamicResource XM.text3}" />

        <!-- TEXT CONTENT single-line editor (collapses to 0 when the element has element children) -->
        <Grid x:Name="TextRow" Grid.Row="3" Margin="10,4,10,8">
            <TextBox x:Name="TextField"
                     Height="22"
                     VerticalContentAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas"
                     Foreground="{DynamicResource XM.syntaxText}"
                     Background="{DynamicResource XM.bgDeep}"
                     BorderBrush="{DynamicResource XM.hairlineS}"
                     BorderThickness="0.5" />
            <TextBlock x:Name="TextPlaceholder"
                       Text="(no text content)"
                       Margin="6,0,0,0"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas"
                       Foreground="{DynamicResource XM.text3}"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
