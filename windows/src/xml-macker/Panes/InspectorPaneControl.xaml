<UserControl x:Class="XMLMacker.Panes.InspectorPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XMLMacker.Panes"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Two-tone title line: '<tag>' in syntaxTag over the quiet 'N attrs · M children' suffix. -->
        <TextBlock x:Name="Title" Grid.Row="0"
                   Margin="10,8,10,0"
                   TextTrimming="CharacterEllipsis" />

        <local:AttributesBarControl x:Name="Attrs" Grid.Row="1"
                                    Margin="0,10,0,0"
                                    MinHeight="124" />
    </Grid>
</UserControl>
