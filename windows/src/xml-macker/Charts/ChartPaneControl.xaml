<UserControl x:Class="XMLMacker.Charts.ChartPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:XMLMacker.Charts">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  "Variable:" label + dropdown row (hidden unless ≥2 chartable variables)  -->
        <StackPanel x:Name="VarRow"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="10,6,10,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="VarLabel"
                       Text="Variable:"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource XM.text3}" />
            <ComboBox x:Name="VarPopup"
                      Margin="8,0,0,0"
                      MaxWidth="220"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource XM.text}"
                      SelectionChanged="VarPopup_SelectionChanged" />
        </StackPanel>

        <!--  The inline chart fills the remaining space  -->
        <charts:TrendView x:Name="Trend"
                          Grid.Row="1"
                          Margin="8,6,8,8" />
    </Grid>
</UserControl>
