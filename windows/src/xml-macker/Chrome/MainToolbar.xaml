<UserControl x:Class="XMLMacker.Chrome.MainToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Icon-only toolbar button: Segoe Fluent / MDL2 glyph, subtle hover pill. -->
        <Style x:Key="XM.ToolButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.glassTop}" />
                                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same, but its Background shows (the highlighter lights up while the marker is on). -->
        <Style x:Key="XM.ToolButtonToggle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.glassTop}" />
                                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clearly-labelled Windows document actions. -->
        <Style x:Key="XM.FileActionButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
            <Setter Property="Background" Value="{DynamicResource XM.bgDeep}" />
            <Setter Property="BorderBrush" Value="{DynamicResource XM.hairlineS}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.glassTop}" />
                                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Workspace capsule segment (selectOne). -->
        <Style x:Key="XM.WorkspaceSegment" TargetType="ToggleButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.glassTop}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource XM.bg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DIFF text button. -->
        <Style x:Key="XM.DiffButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{DynamicResource XM.glassTop}"
                                BorderBrush="{DynamicResource XM.hairlineS}"
                                BorderThickness="0.5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="8,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Standard Windows document actions: familiar glyph plus an explicit label. -->
            <Button x:Name="OpenBtn" Style="{StaticResource XM.FileActionButton}"
                    ToolTip="Open file (Ctrl+O)" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Open" FontFamily="Segoe UI" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveBtn" Style="{StaticResource XM.FileActionButton}"
                    ToolTip="Save file (Ctrl+S)" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Save" FontFamily="Segoe UI" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CloseBtn" Style="{StaticResource XM.FileActionButton}"
                    ToolTip="Close current file (Ctrl+W)" Click="Close_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="Close" FontFamily="Segoe UI" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource XM.hairline}" />

            <!-- undo, redo -->
            <Button x:Name="UndoBtn" Style="{StaticResource XM.ToolButton}" Content="&#xE7A7;" ToolTip="Undo" Click="Undo_Click" />
            <Button x:Name="RedoBtn" Style="{StaticResource XM.ToolButton}" Content="&#xE7A6;" ToolTip="Redo" Click="Redo_Click" />

            <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource XM.hairline}" />

            <!-- workspace capsule + diff -->
            <TextBlock Text="LAYOUT" VerticalAlignment="Center" Margin="0,1,6,0"
                       FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource XM.text3}"
                       ToolTip="Layout: which panes are on screen" />
            <Border CornerRadius="9" Height="28"
                    Background="{DynamicResource XM.bgDeep}"
                    BorderBrush="{DynamicResource XM.hairlineS}"
                    BorderThickness="0.5"
                    Padding="2"
                    SnapsToDevicePixels="True"
                    ToolTip="Layout: which panes are on screen">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="WsEdit"    Style="{StaticResource XM.WorkspaceSegment}" Content="Simple"  ToolTip="Simple layout: tree, source editor and Subtags table"  Click="Workspace_Click" />
                    <ToggleButton x:Name="WsInspect" Style="{StaticResource XM.WorkspaceSegment}" Content="Inspect" ToolTip="Inspect layout: tree, source editor and the details rail (Inspector, Chart, Preview, Errors)" Click="Workspace_Click" />
                    <ToggleButton x:Name="WsFull"    Style="{StaticResource XM.WorkspaceSegment}" Content="Full"    ToolTip="Full layout: every pane on screen"          Click="Workspace_Click" />
                    <ToggleButton x:Name="WsLearn"   Style="{StaticResource XM.WorkspaceSegment}" Content="Learn"   ToolTip="Learn layout: tree, source editor and the AI chat beside your file" Click="Workspace_Click" />
                </StackPanel>
            </Border>

            <Button x:Name="DiffBtn" Style="{StaticResource XM.DiffButton}" Content="DIFF"
                    ToolTip="Compare two files side by side (git-style diff)" Click="Diff_Click" />

            <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource XM.hairline}" />

            <!-- find + quick search -->
            <Button x:Name="FindBtn" Style="{StaticResource XM.ToolButton}" Content="&#xE721;" ToolTip="Find" Click="Find_Click" />

            <Border CornerRadius="8" Width="200" Height="28" Margin="4,0"
                    Background="{DynamicResource XM.bgDeep}"
                    BorderBrush="{DynamicResource XM.hairlineS}"
                    BorderThickness="0.5"
                    SnapsToDevicePixels="True"
                    ToolTip="Quick find, press Enter to jump to the next match">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Foreground="{DynamicResource XM.text}"
                             CaretBrush="{DynamicResource XM.accent}"
                             FontFamily="Segoe UI"
                             FontSize="12"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />
                    <TextBlock x:Name="SearchHint"
                               Text="Search file&#x2026;"
                               IsHitTestVisible="False"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource XM.text3}"
                               FontFamily="Segoe UI"
                               FontSize="12" />
                </Grid>
            </Border>

            <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource XM.hairline}" />

            <!-- the marker pen: click = marker on/off (pointer becomes a pen, drag over text to mark it); the small
                 chevron picks the colour or the eraser; the down arrow jumps from mark to mark -->
            <Button x:Name="HighlightBtn" Style="{StaticResource XM.ToolButtonToggle}" Content="&#xE7E6;"
                    ToolTip="Highlighter (Ctrl+H): the pointer becomes a marker, drag over text to mark it, click a line to mark the whole line. Click again or press Esc to stop. Right-click for the colours."
                    Click="Highlight_Click" MouseRightButtonUp="HighlightMenu_Click" />
            <Button x:Name="HighlightMenuBtn" Style="{StaticResource XM.ToolButton}" Width="16" FontSize="9" Content="&#xE70D;"
                    ToolTip="Highlighter colours, eraser, remove all" Click="HighlightMenu_Click" />
            <Button x:Name="HighlightJumpBtn" Style="{StaticResource XM.ToolButton}" Width="24" FontSize="12" Content="&#xE74B;"
                    ToolTip="Jump to the next mark (Ctrl+Shift+H), Shift+click for the previous one" Click="HighlightJump_Click" />

            <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource XM.hairline}" />

            <!-- orbit -->
            <Button x:Name="OrbitBtn" Style="{StaticResource XM.ToolButton}" Width="34" ToolTip="Orbit" Click="Orbit_Click">
                <Viewbox Width="24" Height="24" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="6.4" Canvas.Top="6.4" Width="11.2" Height="11.2"
                                 Fill="Transparent" Stroke="#99A8CC" StrokeThickness="1.4" />
                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                 Fill="Transparent" Stroke="#99A8CC" StrokeThickness="1.4" />
                        <Ellipse Canvas.Left="8.9" Canvas.Top="8.9" Width="6.2" Height="6.2" Fill="#4066C7" />
                        <Ellipse Canvas.Left="10.3" Canvas.Top="4.7" Width="3.4" Height="3.4" Fill="#EB824A" />
                        <Ellipse Canvas.Left="3.1" Canvas.Top="14.3" Width="3.6" Height="3.6" Fill="#3DAB91" />
                        <Ellipse Canvas.Left="18.2" Canvas.Top="7.4" Width="3.2" Height="3.2" Fill="#B264BF" />
                    </Canvas>
                </Viewbox>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
