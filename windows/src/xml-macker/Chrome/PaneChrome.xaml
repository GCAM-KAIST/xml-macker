<UserControl x:Class="XMLMacker.Chrome.PaneChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Compact Windows caption button used by every docked pane. -->
        <Style x:Key="XM.PaneCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource XM.text2}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="{DynamicResource XM.glassTop}" />
                                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows reserves red hover feedback for the rightmost Close button. -->
        <Style x:Key="XM.PaneCloseButton" TargetType="Button" BasedOn="{StaticResource XM.PaneCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#FFC50F1F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Grid.Row="0" Height="22">
            <Rectangle Fill="{DynamicResource XM.bg}" Opacity="0.85" />
            <Border BorderBrush="{DynamicResource XM.hairlineS}" BorderThickness="0,0,0,1" />

            <DockPanel LastChildFill="True">
                <StackPanel x:Name="PaneControls" DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Margin="0,0,3,0"
                            VerticalAlignment="Center">
                    <Button x:Name="PopOutButton"
                            Style="{StaticResource XM.PaneCaptionButton}"
                            Content="&#xE8A7;"
                            ToolTip="Open pane in a separate window" Click="PopOut_Click" />
                    <Button x:Name="MinButton" Style="{StaticResource XM.PaneCaptionButton}"
                            Content="&#xE921;"
                            ToolTip="Minimize pane" Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource XM.PaneCaptionButton}"
                            Content="&#xE922;"
                            ToolTip="Maximize pane" Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource XM.PaneCloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="Close pane" Click="CloseButton_Click" />
                </StackPanel>

                <Grid>
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               Margin="10,0,8,0"
                               Foreground="{DynamicResource XM.text2}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <ContentControl x:Name="HeaderAccessory"
                                    Margin="6,1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Grid>

        <Border x:Name="ContentContainer" Grid.Row="1" ClipToBounds="True">
            <ContentPresenter x:Name="PART_Content" />
        </Border>
    </Grid>
</UserControl>
