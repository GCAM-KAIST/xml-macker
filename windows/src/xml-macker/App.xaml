<Application x:Class="XMLMacker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose"
             StartupUri="App/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--  MENUS, fully themed. A WPF menu's popup is otherwise a light Windows box in the system
                  font, which looked foreign on every dark theme. These templates give the bar, the
                  popups, context menus, separators and tool tips the theme's own colours and the app's
                  Segoe UI face, so a menu looks like part of the window it belongs to.  -->

            <!--  Shared look of a popup panel (menus and context menus).  -->
            <Style x:Key="XM.PopupPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource XM.bg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource XM.hairlineS}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!--  Top-level header on the menu bar (File, Edit, View...), owns the drop-down popup.  -->
            <ControlTemplate x:Key="XM.MenuTopLevel" TargetType="MenuItem">
                <Grid>
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="9,3" Margin="1,2">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Border>
                    <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="-6" HorizontalOffset="-8"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Style="{StaticResource XM.PopupPanel}" Margin="8" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.lineHighlight}" />
                    </Trigger>
                    <Trigger Property="IsSubmenuOpen" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.lineHighlight}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource XM.text3}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!--  An item inside a popup (also a sub-menu header: it shows an arrow and owns a popup).  -->
            <ControlTemplate x:Key="XM.MenuSub" TargetType="MenuItem">
                <Grid>
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="6,4" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="check" Text="&#x2713;" Visibility="Hidden"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource XM.text2}" />
                            <TextBlock x:Name="arrow" Text="&#x25B8;" Grid.Column="3" Visibility="Hidden"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-12"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Style="{StaticResource XM.PopupPanel}" Margin="8" MinWidth="160">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="check" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuHeader">
                        <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource XM.lineHighlight}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource XM.text3}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="Menu">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{DynamicResource XM.bg}" />
                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Template" Value="{StaticResource XM.MenuSub}" />
                <Style.Triggers>
                    <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter Property="Template" Value="{StaticResource XM.MenuTopLevel}" />
                        <Setter Property="FontSize" Value="13" />
                    </Trigger>
                    <Trigger Property="Role" Value="TopLevelItem">
                        <Setter Property="Template" Value="{StaticResource XM.MenuTopLevel}" />
                        <Setter Property="FontSize" Value="13" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  The thin rule between menu groups.  -->
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="8,4" Background="{DynamicResource XM.hairlineS}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ContextMenu">
                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Style="{StaticResource XM.PopupPanel}" MinWidth="160">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  TABLES. WPF's stock selection is solid Windows-blue with white text; in this app the
                  cells carry their own syntax colours, so a selected row turned violet-on-blue and
                  vanished. Every table now selects with the theme's soft line-highlight wash under
                  UNCHANGED text, hovers with the panel tint, and has themed column headers.  -->
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource XM.panel}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource XM.lineHighlight}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Padding" Value="4,2" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource XM.lineHighlight}" />
                        <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource XM.panel}" />
                <Setter Property="Foreground" Value="{DynamicResource XM.text3}" />
                <Setter Property="BorderBrush" Value="{DynamicResource XM.hairlineS}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource XM.panel}" />
                <Setter Property="Foreground" Value="{DynamicResource XM.text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource XM.hairlineS}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11.5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
