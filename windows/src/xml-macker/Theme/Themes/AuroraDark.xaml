<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aurora Dark (id="aurora-dark", default, isDark=true) -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="XM.bg"        Color="#FF0C1016" />
    <SolidColorBrush x:Key="XM.bgDeep"    Color="#FF070A10" />
    <SolidColorBrush x:Key="XM.panel"     Color="#94141A24" />
    <SolidColorBrush x:Key="XM.hairline"  Color="#12FFFFFF" />
    <SolidColorBrush x:Key="XM.hairlineS" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="XM.glassTop"  Color="#14FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="XM.text"  Color="#F0F0F4FC" />
    <SolidColorBrush x:Key="XM.text2" Color="#99F0F4FC" />
    <SolidColorBrush x:Key="XM.text3" Color="#5CF0F4FC" />

    <!-- Syntax -->
    <SolidColorBrush x:Key="XM.syntaxTag"   Color="#FFC4A4FF" />
    <SolidColorBrush x:Key="XM.syntaxAttr"  Color="#FF7ED6FF" />
    <SolidColorBrush x:Key="XM.syntaxVal"   Color="#FFFFC78A" />
    <SolidColorBrush x:Key="XM.syntaxText"  Color="#FFA8E6B6" />
    <SolidColorBrush x:Key="XM.syntaxPunct" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="XM.syntaxCom"   Color="#4DFFFFFF" />

    <!-- Accents / semantic -->
    <SolidColorBrush x:Key="XM.accent"  Color="#FF64B5FF" />
    <SolidColorBrush x:Key="XM.accent2" Color="#FFC4A4FF" />
    <SolidColorBrush x:Key="XM.ok"      Color="#FF3DDC97" />
    <SolidColorBrush x:Key="XM.warn"    Color="#FFF5C469" />
    <SolidColorBrush x:Key="XM.err"     Color="#FFFF6B7A" />

    <!-- Editor -->
    <SolidColorBrush x:Key="XM.lineHighlight" Color="#99264F78" />
</ResourceDictionary>
