<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solarized Dark (id="solarized-dark", isDark=true) -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="XM.bg"        Color="#FF002B36" />
    <SolidColorBrush x:Key="XM.bgDeep"    Color="#FF001F27" />
    <SolidColorBrush x:Key="XM.panel"     Color="#94053642" />
    <SolidColorBrush x:Key="XM.hairline"  Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="XM.hairlineS" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="XM.glassTop"  Color="#0DFFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="XM.text"  Color="#FF93A1A1" />
    <SolidColorBrush x:Key="XM.text2" Color="#FF839496" />
    <SolidColorBrush x:Key="XM.text3" Color="#FF657B83" />

    <!-- Syntax -->
    <SolidColorBrush x:Key="XM.syntaxTag"   Color="#FF268BD2" />
    <SolidColorBrush x:Key="XM.syntaxAttr"  Color="#FF2AA198" />
    <SolidColorBrush x:Key="XM.syntaxVal"   Color="#FFB58900" />
    <SolidColorBrush x:Key="XM.syntaxText"  Color="#FF859900" />
    <SolidColorBrush x:Key="XM.syntaxPunct" Color="#FF93A1A1" />
    <SolidColorBrush x:Key="XM.syntaxCom"   Color="#FF586E75" />

    <!-- Accents / semantic -->
    <SolidColorBrush x:Key="XM.accent"  Color="#FF268BD2" />
    <SolidColorBrush x:Key="XM.accent2" Color="#FFD33682" />
    <SolidColorBrush x:Key="XM.ok"      Color="#FF859900" />
    <SolidColorBrush x:Key="XM.warn"    Color="#FFCB4B16" />
    <SolidColorBrush x:Key="XM.err"     Color="#FFDC322F" />

    <!-- Editor -->
    <SolidColorBrush x:Key="XM.lineHighlight" Color="#D90A4A5A" />
</ResourceDictionary>
