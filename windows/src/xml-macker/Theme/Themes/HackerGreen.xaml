<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hacker (id="hacker-green", isDark=true), Matrix green phosphor. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="XM.bg"        Color="#FF020A05" />
    <SolidColorBrush x:Key="XM.bgDeep"    Color="#FF000000" />
    <SolidColorBrush x:Key="XM.panel"     Color="#99001408" />
    <SolidColorBrush x:Key="XM.hairline"  Color="#1A00FF41" />
    <SolidColorBrush x:Key="XM.hairlineS" Color="#4000FF41" />
    <SolidColorBrush x:Key="XM.glassTop"  Color="#0D00FF41" />

    <!-- Text -->
    <SolidColorBrush x:Key="XM.text"  Color="#FFB4FFC6" />
    <SolidColorBrush x:Key="XM.text2" Color="#FF6BD98A" />
    <SolidColorBrush x:Key="XM.text3" Color="#FF3E8A54" />

    <!-- Syntax -->
    <SolidColorBrush x:Key="XM.syntaxTag"   Color="#FF00FF41" />
    <SolidColorBrush x:Key="XM.syntaxAttr"  Color="#FF7EE787" />
    <SolidColorBrush x:Key="XM.syntaxVal"   Color="#FFD8FFB0" />
    <SolidColorBrush x:Key="XM.syntaxText"  Color="#FFEFFFF2" />
    <SolidColorBrush x:Key="XM.syntaxPunct" Color="#FF2EA043" />
    <SolidColorBrush x:Key="XM.syntaxCom"   Color="#FF1F6F35" />

    <!-- Accents / semantic -->
    <SolidColorBrush x:Key="XM.accent"  Color="#FF00FF41" />
    <SolidColorBrush x:Key="XM.accent2" Color="#FF39FF14" />
    <SolidColorBrush x:Key="XM.ok"      Color="#FF00FF41" />
    <SolidColorBrush x:Key="XM.warn"    Color="#FFFFD75E" />
    <SolidColorBrush x:Key="XM.err"     Color="#FFFF4D4D" />

    <!-- Editor -->
    <SolidColorBrush x:Key="XM.lineHighlight" Color="#2900FF41" />
</ResourceDictionary>
