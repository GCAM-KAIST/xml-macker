<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One Dark (id="one-dark", isDark=true) -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="XM.bg"        Color="#FF282C34" />
    <SolidColorBrush x:Key="XM.bgDeep"    Color="#FF21252B" />
    <SolidColorBrush x:Key="XM.panel"     Color="#942D323C" />
    <SolidColorBrush x:Key="XM.hairline"  Color="#12FFFFFF" />
    <SolidColorBrush x:Key="XM.hairlineS" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="XM.glassTop"  Color="#0FFFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="XM.text"  Color="#FFABB2BF" />
    <SolidColorBrush x:Key="XM.text2" Color="#FF828997" />
    <SolidColorBrush x:Key="XM.text3" Color="#FF5C6370" />

    <!-- Syntax -->
    <SolidColorBrush x:Key="XM.syntaxTag"   Color="#FFE06C75" />
    <SolidColorBrush x:Key="XM.syntaxAttr"  Color="#FFD19A66" />
    <SolidColorBrush x:Key="XM.syntaxVal"   Color="#FF98C379" />
    <SolidColorBrush x:Key="XM.syntaxText"  Color="#FF61AFEF" />
    <SolidColorBrush x:Key="XM.syntaxPunct" Color="#FFABB2BF" />
    <SolidColorBrush x:Key="XM.syntaxCom"   Color="#FF5C6370" />

    <!-- Accents / semantic -->
    <SolidColorBrush x:Key="XM.accent"  Color="#FF61AFEF" />
    <SolidColorBrush x:Key="XM.accent2" Color="#FFC678DD" />
    <SolidColorBrush x:Key="XM.ok"      Color="#FF98C379" />
    <SolidColorBrush x:Key="XM.warn"    Color="#FFE5C07B" />
    <SolidColorBrush x:Key="XM.err"     Color="#FFE06C75" />

    <!-- Editor -->
    <SolidColorBrush x:Key="XM.lineHighlight" Color="#E63E4451" />
</ResourceDictionary>
