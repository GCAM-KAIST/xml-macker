<Window x:Class="XMLMacker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:XMLMacker.Chrome"
        xmlns:panes="clr-namespace:XMLMacker.Panes"
        Title="xml-macker"
        Width="1440"
        Height="900"
        MinWidth="720"
        MinHeight="520"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource XM.bg}"
        Foreground="{DynamicResource XM.text}">

    <!-- Root shell: menu / toolbar / tab strip / breadcrumb / pane host / status bar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 0 menu bar -->
            <RowDefinition Height="Auto" />
            <!-- 1 toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 2 tab strip -->
            <RowDefinition Height="Auto" />
            <!-- 3 breadcrumb -->
            <RowDefinition Height="*" />
            <!-- 4 pane host -->
            <RowDefinition Height="Auto" />
            <!-- 5 status bar -->
        </Grid.RowDefinitions>

        <!-- Menu bar (fully populated in BuildMenuBar()). -->
        <Menu x:Name="MenuBar"
              Grid.Row="0"
              Background="{DynamicResource XM.bg}"
              Foreground="{DynamicResource XM.text}" />

        <!-- Toolbar. -->
        <chrome:MainToolbar x:Name="Toolbar" Grid.Row="1" />

        <!-- Multi-document tab strip. -->
        <chrome:TabStripControl x:Name="TabStrip" Grid.Row="2" />

        <!-- Ancestor breadcrumb bar. -->
        <panes:BreadcrumbBar x:Name="Breadcrumb" Grid.Row="3" />

        <!-- The nested split pane layout is built in code and planted here. -->
        <Border x:Name="PaneHost"
                Grid.Row="4"
                Margin="8,4,8,4"
                Background="Transparent" />

        <!-- Status bar: progress fill (behind) + centered filename + zoom widget. -->
        <Grid x:Name="StatusBarGrid"
              Grid.Row="5"
              Background="{DynamicResource XM.bg}">

            <!-- Accent progress swipe, width driven by ProgressFill, sits behind everything. -->
            <Rectangle x:Name="ProgressRect"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Width="0"
                       IsHitTestVisible="False" />

            <!-- Centered, middle-truncating filename / status. -->
            <TextBlock x:Name="StatusLabel"
                       Text="Open a file (Ctrl+O)"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="120,0,320,0"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       Foreground="{DynamicResource XM.text3}" />

            <!-- Zoom widget: [-] [====slider====] [+] [100%] [reset] -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button x:Name="ZoomMinusButton"
                        Content="−"
                        Width="20"
                        FontWeight="SemiBold"
                        Focusable="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource XM.text2}"
                        Click="ZoomMinus_Click" />
                <Slider x:Name="ZoomSlider"
                        Width="140"
                        Minimum="0"
                        Maximum="100"
                        Value="50"
                        VerticalAlignment="Center"
                        SmallChange="5"
                        TickFrequency="16.6"
                        TickPlacement="BottomRight"
                        IsSnapToTickEnabled="False"
                        ValueChanged="ZoomSlider_ValueChanged" />
                <Button x:Name="ZoomPlusButton"
                        Content="+"
                        Width="20"
                        FontWeight="SemiBold"
                        Focusable="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource XM.text2}"
                        Click="ZoomPlus_Click" />
                <TextBlock x:Name="ZoomPercentLabel"
                           Text="100%"
                           Width="38"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource XM.text2}" />
                <Button x:Name="ZoomResetButton"
                        Content="↺"
                        Width="20"
                        Focusable="False"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Reset zoom to 100%"
                        Foreground="{DynamicResource XM.text3}"
                        Click="ZoomReset_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
