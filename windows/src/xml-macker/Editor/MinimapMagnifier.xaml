<Window x:Class="XMLMacker.Editor.MinimapMagnifier"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Width="380" Height="240"
        SizeToContent="Manual">
    <!-- The single custom-drawing content view is created and inserted in code-behind
         (MagnifierContentView). A drop shadow gives the floating panel depth (Swift hasShadow). -->
    <Grid x:Name="Host">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000" />
        </Grid.Effect>
    </Grid>
</Window>
