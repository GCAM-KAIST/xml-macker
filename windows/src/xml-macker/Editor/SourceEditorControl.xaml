<UserControl x:Class="XMLMacker.Editor.SourceEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource XM.bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header row: file caption (left) + loading spinner (right) -->
        <Grid Grid.Row="0" Height="18" Margin="8,4,8,0">
            <TextBlock x:Name="HeaderLabel"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="0,0,24,0"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="Segoe UI" FontSize="10"
                       Foreground="{DynamicResource XM.text3}" />
            <Grid x:Name="SpinnerHost" Width="14" Height="14"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Visibility="Collapsed" />
        </Grid>

        <!-- Body: gutter | editor | (8px gap) minimap. Children are added in code-behind. -->
        <Grid x:Name="Body" Grid.Row="1" Margin="0,4,0,0"
              Background="{DynamicResource XM.bgDeep}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</UserControl>
